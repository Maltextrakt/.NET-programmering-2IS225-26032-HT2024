@model IEnumerable<Miljoboven.Models.ViewModels.MyErrand>

@{
    var controllerName = ViewBag.ControllerName;
    var actionName = ViewBag.actionName;
}

<table>
    <tr>
        <th>Ärende anmält</th>
        <th>Ärendenummer</th>
        <th>Miljöbrott</th>
        <th>Status</th>
        <th>Avdelning</th>
        <th>Handläggare</th>
    </tr>
    @if (Model.Any())
    {
        @foreach (var errand in Model)
        {
            <tr>
                <td>@errand.DateOfObservation.ToString("yyyy-MM-dd")</td>
                <td>
                    <a asp-controller="@controllerName" asp-action="@actionName" asp-route-id="@errand.ErrandId">@errand.RefNumber</a>
                </td>
                <td>@errand.TypeOfCrime</td>
                <td>@errand.StatusName</td>
                <td>@errand.DepartmentName</td>
                <td>@errand.EmployeeName</td>
            </tr>
        }
    }
    else
    {
        <tr>
            <td colspan="6">Inga ärenden funna</td>
        </tr>
    }
</table>
