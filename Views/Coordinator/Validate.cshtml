@model Errand

@{
    Layout = "_CoordinatorLayout";
}
<h2>Din anmälan av miljöbrott</h2>
<p class="info">Du är inloggad som samordnare</p>

@await Component.InvokeAsync("ValidateCrime", new { errand = Model })


<p>
    <a class="button" asp-controller="Coordinator" asp-action="ReportCrime" id="link">Tillbaka</a>
    <a class="button" asp-controller="Coordinator" asp-action="Thanks">Bekräfta</a>
</p>